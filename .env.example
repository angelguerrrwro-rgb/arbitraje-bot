# Copia como .env. NUNCA subas este archivo a ningún sitio.
# Al crear la clave en Binance: activa SOLO "Enable Spot & Margin Trading",
# NUNCA "Enable Withdrawals", y restringe la clave a tu IP.

# Modo real
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Modo testnet (claves de https://testnet.binance.vision)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Avisos opcionales
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
