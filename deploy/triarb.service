[Unit]
Description=Bot de arbitraje triangular (modo definido en config.toml)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/.venv/bin/python -m triarb --sin-pantalla
Restart=always
RestartSec=10
# El modo real exige además --confirmo-dinero-real en ExecStart: no lo añadas hasta haber
# validado semanas en papel y testnet.

[Install]
WantedBy=multi-user.target
